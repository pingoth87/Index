# Copia este archivo como ".env" (sin .example) y pon tus propios valores.
# NUNCA subas el archivo ".env" real a GitHub — ya está en .gitignore.

# Genera una clave segura con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pon_aqui_una_clave_larga_y_aleatoria

# Puerto donde corre el servidor
PORT=3000

# "production" activa cookies solo-HTTPS. Deja "development" mientras pruebas en local.
NODE_ENV=development
